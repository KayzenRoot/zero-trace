<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Startup.uss" />
    <ui:VisualElement name="startup-root" class="startup-root">
        <ui:VisualElement class="startup-panel">
            <ui:Label name="product-title" class="product-title" text="ZERO TRACE" />
            <ui:VisualElement class="accent-rule" />
            <ui:Label name="status-label" class="status-label" text="Starting local language data..." />
            <ui:Label name="language-label" class="language-label" text="Language" />
            <ui:VisualElement class="locale-row">
                <ui:Button name="language-en" class="locale-button" text="English (US)" />
                <ui:Button name="language-pt" class="locale-button" text="Português (Brasil)" />
            </ui:VisualElement>
            <ui:Label name="prototype-notice" class="prototype-notice" text="LOCAL TECHNICAL PROTOTYPE — NOT RELEASE CONTENT" />
            <ui:Button name="prototype-launch" class="prototype-launch" text="Start local prototype" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
